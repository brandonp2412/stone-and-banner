#!/usr/bin/env bash
# Install a project-local SDK without modifying the user's shared Flutter SDK.
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
sdk_root="$project_root/flutter"
revision=$(cat "$project_root/.flutter-revision")
if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Invalid .flutter-revision; expected a full Git commit hash.' >&2
  exit 1
fi
if [[ ! -d "$sdk_root" ]]; then
  mkdir "$sdk_root"
  git -C "$sdk_root" init
  git -C "$sdk_root" remote add origin https://github.com/flutter/flutter.git
fi
if [[ ! -d "$sdk_root/.git" ]]; then
  echo 'flutter/ already exists and is not an SDK Git checkout; leaving it untouched.' >&2
  exit 1
fi
if [[ -n "$(git -C "$sdk_root" status --porcelain --untracked-files=no)" ]]; then
  echo 'flutter/ has local edits; leaving them untouched.' >&2
  exit 1
fi
if ! git -C "$sdk_root" cat-file -e "$revision^{commit}" 2>/dev/null; then
  git -C "$sdk_root" fetch --depth 1 origin "$revision"
fi
git -C "$sdk_root" checkout --detach "$revision"
"$project_root/tool/flutterw" precache --linux --android
"$project_root/tool/flutterw" pub get
